# Environment variables read by gateway.py / weather.py / rules.py (set them in the shell, e.g. PowerShell: $env:VOLTGUARD_LAT="12.97"). Defaults shown.
# Site used for the Open-Meteo forecast / historical weather (no API key needed)
VOLTGUARD_LOCATION=Bengaluru
VOLTGUARD_LAT=12.9716
VOLTGUARD_LON=77.5946
VOLTGUARD_TZ=Asia/Kolkata
# Rule-Based Demo threshold: alert when temperature > this value (°C)
VOLTGUARD_TEMP_THRESHOLD_C=30
# Gateway
VOLTGUARD_GATEWAY_HOST=127.0.0.1
VOLTGUARD_GATEWAY_PORT=5001
VOLTGUARD_SIM_TICK_S=2
